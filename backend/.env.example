# Urimai AI — Backend Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT SEPARATION:
# Use distinct Supabase projects and API keys for dev, staging, and production.
# NEVER share database instances or service role keys across environments.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment & Logging ───────────────────────────────────────────────────
# Options: development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Sentry DSN for Error Monitoring (Optional in dev, Strongly Recommended in staging/prod)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Development (defaults to local SQLite if empty):
DATABASE_URL=sqlite:///./urimai_local.db

# Staging:
# DATABASE_URL=postgresql://postgres:[STAGING-PASSWORD]@db.[STAGING-REF].supabase.co:5432/postgres
# SUPABASE_URL=https://[STAGING-REF].supabase.co
# SUPABASE_KEY=[STAGING-ANON-KEY]

# Production:
# DATABASE_URL=postgresql://postgres:[PROD-PASSWORD]@db.[PROD-REF].supabase.co:5432/postgres
# SUPABASE_URL=https://[PROD-REF].supabase.co
# SUPABASE_KEY=[PROD-ANON-KEY]

# ── Security & Authentication ───────────────────────────────────────────────
# In production, generate a secure 64-char random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=urimai-ai-super-secure-secret-key-2026
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://urimai.tn.gov.in

# OTP Security & Throttling
OTP_EXPIRY_SECONDS=300
OTP_MAX_FAILED_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=600

# Rate Limiting
RATE_LIMIT_ENABLED=true

# ── Google Gemini (LLM + Embeddings) ────────────────────────────────────────
# Required for: Tamil NLU extraction fallback & grounded citizen guidance
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=[YOUR-GOOGLE-API-KEY]

# ── Pinecone (Vector Store for RAG) ─────────────────────────────────────────
# Required for: scheme GO retrieval & grounded step-by-step guidance
# Get from: https://app.pinecone.io
PINECONE_API_KEY=[YOUR-PINECONE-API-KEY]
PINECONE_INDEX_NAME=urimai-schemes
PINECONE_ENVIRONMENT=us-east-1-aws

# ── RAG / LLM Feature Flags ────────────────────────────────────────────────
# Set LLM_ENABLED=false to run pure deterministic mode without external AI calls
LLM_ENABLED=true
RAG_SIMILARITY_THRESHOLD=0.70
